{:paths ["src" "test"]
 :tasks {test {:requires ([clojure.test :as t] [babashka.fs :as fs])
               :task (do (doseq [f (fs/glob "test" "**/*_test.clj")] (load-file (str f)))
                         (let [{:keys [fail error]} (t/run-all-tests (re-pattern "shop\\..*-test"))]
                           (System/exit (+ fail error))))}}}
